# Copy this file to deploy/xiangwan/.env, then replace every REQUIRED value.
# The .env file is ignored by Git. Do not store production credentials in source control.

# Customer-owned immutable image references. Set these to the exact image tag
# or digest that the customer's GitHub/GHCR or private registry publishes.
XIANGWAN_IMAGE=REPLACE_WITH_CUSTOMER_REGISTRY/xiangwan-api:REPLACE_WITH_IMMUTABLE_TAG
XIANGWAN_MIGRATE_IMAGE=REPLACE_WITH_CUSTOMER_REGISTRY/xiangwan-migrate:REPLACE_WITH_IMMUTABLE_TAG

# PostgreSQL is the only Xiangwan state and coordination service. No Redis.
XIANGWAN_POSTGRES_USER=xiangwan
XIANGWAN_POSTGRES_DB=xiangwan
# REQUIRED: uncomment and fill in the private .env only.
# POSTGRES_PASSWORD=REPLACE_WITH_INDEPENDENT_RANDOM_PASSWORD
# XIANGWAN_API_DATABASE_DSN=REPLACE_WITH_LEAST_PRIVILEGE_API_DSN
# DATABASE_DSN=REPLACE_WITH_MIGRATION_BOOTSTRAP_DSN
# XIANGWAN_ACTIVATION_DATABASE_DSN=REPLACE_WITH_DEPLOYMENT_ROLE_DSN
# XIANGWAN_EXPECTED_WRITE_EPOCH=REPLACE_WITH_OBSERVED_CURRENT_EPOCH
# XIANGWAN_MEDIA_CLEANUP_DATABASE_DSN=REPLACE_WITH_PRIVATE_FILE_CLEANUP_DSN
# XIANGWAN_COUPON_RECONCILIATION_DATABASE_DSN=REPLACE_WITH_COUPON_WORKER_DSN
# XIANGWAN_COUPON_GRANT_POLICY_PUBLIC_KEY=REPLACE_WITH_BASE64_ED25519_PUBLIC_KEY
#   for customer-signed future Coupon policy versions. Omit until the full
#   administrator OIDC boundary and customer approval workflow are ready.

# REQUIRED. Generate these UUIDs before first boot; bootstrap provisions and
# activates that exact pair. On upgrades, observe the current database authority
# first. A different generation requires the explicit activation operation.
XIANGWAN_TENANT_ID=REPLACE_WITH_CUSTOMER_TENANT_UUID
XIANGWAN_GENERATION_ID=REPLACE_WITH_ACTIVE_GENERATION_UUID

# REQUIRED: uncomment and fill in the private .env only. Use independent
# high-entropy values; do not reuse the database password.
# JWT_SIGNING_KEY=REPLACE_WITH_INDEPENDENT_RANDOM_SIGNING_KEY
# XIANGWAN_CHECKIN_CREDENTIAL_HMAC_KEY=REPLACE_WITH_INDEPENDENT_RANDOM_HMAC_KEY

# Customer-owned WeChat Mini Program identity. AppSecret stays server-side only.
XIANGWAN_APP_ID=wx05ff9791f73fe3bd
# REQUIRED: uncomment in the private .env only.
# XIANGWAN_APP_SECRET=REPLACE_WITH_MATCHING_WECHAT_APP_SECRET

# Consumer avatar moderation. The server-side WeChat img_sec_check review is
# ON and fixed in the production Compose profile. Local development bypasses
# must never be introduced into the customer deployment.

# Network. Keep the API loopback-bound unless a customer reverse proxy is configured.
XIANGWAN_PUBLISHED_PORT=8082
TZ=Asia/Shanghai
SERVER_TRUSTED_PROXIES=127.0.0.1,::1,172.16.0.0/12,10.0.0.0/8,192.168.0.0/16

# Coolify compose deployment: hostname only, without https://. Coolify uses
# SERVICE_FQDN_API_8080 (or the API component Domains field) to route the
# internal API port 8080. Leave empty on the offline path.
SERVICE_FQDN_API_8080=
XIANGWAN_DEPLOY_REASON=initial release

# Optional configuration is intentionally omitted. Add a complete approved group
# only when enabling it: admin OIDC, legal policy versions, manual contact,
# payment, or reconciliation workers. Empty optional variables are not a valid
# substitute for an omitted configuration group.
