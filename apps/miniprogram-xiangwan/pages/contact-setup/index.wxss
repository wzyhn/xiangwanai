.setup-page {
  padding-top: 34rpx;
}
.setup-card,
.setup-policy {
  padding: 34rpx 30rpx;
  border: 1rpx solid #e6ebf1;
  border-radius: 22rpx;
  background: #fff;
}
.setup-title {
  margin-top: 12rpx;
  color: #10233f;
  font-size: 44rpx;
  font-weight: 800;
}
.setup-description {
  margin: 16rpx 0 34rpx;
  color: #667386;
  font-size: 26rpx;
  line-height: 1.6;
}
.setup-card .field-label {
  margin-top: 22rpx;
}
.setup-optional-heading {
  margin-top: 36rpx;
}
.setup-policy {
  margin-top: 20rpx;
}
.setup-policy .section-heading {
  margin-top: 0;
}
.setup-policy-text {
  margin: 18rpx 0 8rpx;
  padding: 20rpx;
  border-radius: 12rpx;
  background: #f7fafc;
  color: #39475b;
  font-size: 24rpx;
  line-height: 1.65;
  white-space: pre-wrap;
}
.setup-save {
  margin-top: 28rpx;
  width: 100%;
}
.setup-skip {
  margin-top: 12rpx;
  width: 100%;
}
