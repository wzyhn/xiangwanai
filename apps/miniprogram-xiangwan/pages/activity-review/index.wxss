.review-page {
  padding-top: 0;
  background: #ffffff;
}

.review-hero {
  position: relative;
  overflow: hidden;
  margin: 0;
  padding: 54rpx 0 42rpx;
  background: #ffffff;
  color: #10233f;
}

.review-hero-image {
  display: block;
  width: calc(100% + 56rpx);
  height: 430rpx;
  margin: 0 -28rpx;
  border-radius: 0;
  background: #edf1f6;
}

.review-hero::after {
  position: absolute;
  right: -80rpx;
  bottom: -120rpx;
  width: 360rpx;
  height: 360rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.18);
  border-radius: 50%;
  content: "";
}

.review-hero-kicker,
.review-hero-title,
.review-hero-series,
.review-hero-meta {
  position: relative;
  z-index: 1;
}

.review-hero-kicker {
  display: inline-flex;
  padding: 10rpx 20rpx;
  border-radius: 8rpx;
  background: #dcecfb;
  color: #29476c;
  font-size: 22rpx;
}

.review-hero-title {
  margin-top: 24rpx;
  color: #10233f;
  font-size: 48rpx;
  font-weight: 800;
  line-height: 1.25;
  word-break: break-all;
}

.review-hero-series {
  margin-top: 10rpx;
  color: #7c8796;
  font-size: 24rpx;
}

.review-hero-meta {
  margin-top: 24rpx;
  color: #7c8796;
  font-size: 23rpx;
}

.review-stats {
  display: inline-block;
  margin-top: 22rpx;
  padding: 0;
  border-radius: 0;
  background: transparent;
  color: #7c8796;
  font-size: 27rpx;
  line-height: 1.5;
}

.review-instance-content {
  margin-top: 46rpx;
}

.review-instance-text,
.review-instance-image-wrap {
  margin-top: 22rpx;
}

.review-instance-text-title {
  margin-bottom: 8rpx;
  color: #10233f;
  font-size: 29rpx;
  font-weight: 700;
  line-height: 1.45;
}

.review-instance-image-caption {
  margin-top: 8rpx;
  color: #7c8796;
  font-size: 23rpx;
  line-height: 1.55;
}

.review-document {
  margin-top: 50rpx;
}

.review-section-title {
  margin-bottom: 18rpx;
  color: #10233f;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1.35;
}

.review-block {
  margin-top: 20rpx;
}

.review-text {
  color: #31445e;
  font-size: 27rpx;
  line-height: 1.75;
  white-space: pre-wrap;
  word-break: break-all;
}

.review-image,
.review-audio {
  width: 100%;
  overflow: hidden;
  border-radius: 12rpx;
  background: #edf1f6;
}

.review-photo-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14rpx;
}

.review-photo {
  display: block;
  width: 100%;
  height: 250rpx;
  overflow: hidden;
  border-radius: 14rpx;
  background: #edf1f6;
}

.review-photo:first-child:last-child {
  width: 58%;
  height: 310rpx;
}

.review-video {
  display: block;
  width: 100%;
  height: 360rpx;
  overflow: hidden;
  border-radius: 14rpx;
  background: #edf1f6;
}

.review-resource-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #e6ebf1;
}

.review-resource-icon {
  display: grid;
  width: 58rpx;
  height: 58rpx;
  flex: none;
  place-items: center;
  border-radius: 14rpx;
  background: #eef5fb;
  color: #29476c;
  font-size: 28rpx;
}

.review-resource-copy {
  min-width: 0;
  flex: 1;
}

.review-resource-title {
  overflow: hidden;
  color: #10233f;
  font-size: 25rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.review-resource-note {
  margin-top: 6rpx;
  color: #7c8796;
  font-size: 21rpx;
}

.session-resource-button,
.resource-error {
  margin-top: 22rpx;
}

.resource-button {
  width: 100%;
}

.resource-unavailable {
  padding: 20rpx;
  border-radius: 10rpx;
  background: #f5f7fa;
  color: #8793a5;
  font-size: 23rpx;
  line-height: 1.6;
}

/* 原型 next-event 面板 */
.next-instance {
  margin-top: 44rpx;
  padding: 28rpx;
  border-radius: 18rpx;
  background: #edf4fb;
}

.next-kicker {
  color: #4a7299;
  font-size: 20rpx;
  letter-spacing: 2rpx;
}

.next-instance-title {
  margin-top: 14rpx;
  color: #10233f;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.4;
}

.next-copy {
  margin-top: 12rpx;
  color: #4a7299;
  font-size: 22rpx;
  line-height: 1.6;
}

.next-button {
  margin-top: 22rpx;
}

.next-instance .next-button {
  width: auto;
  padding: 0;
  border: 0;
  background: transparent;
  color: #10233f;
  font-size: 25rpx;
  line-height: 1.4;
}
