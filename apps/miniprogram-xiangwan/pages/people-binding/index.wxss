.page {
  padding: 32rpx;
  color: #12263f;
  background: #f7f8fa;
  min-height: 100vh;
  box-sizing: border-box;
}
.panel {
  background: white;
  padding: 28rpx;
  border-radius: 24rpx;
  margin-bottom: 24rpx;
}
.title {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 18rpx;
}
.hint {
  font-size: 26rpx;
  line-height: 1.7;
  color: #687482;
  margin-bottom: 18rpx;
}
.label {
  margin: 24rpx 0 12rpx;
}
.required,
.error {
  color: #c52631;
}
.error {
  padding: 12rpx 0 24rpx;
  line-height: 1.6;
}
textarea {
  width: 100%;
  height: 140rpx;
  border: 1rpx solid #cdd3db;
  padding: 16rpx;
  border-radius: 12rpx;
  box-sizing: border-box;
}
.copy {
  white-space: pre-wrap;
  margin: 20rpx 0;
  line-height: 1.7;
}
button {
  margin-top: 24rpx;
  color: white;
  background: #12263f;
}
label {
  line-height: 1.7;
  font-size: 28rpx;
}
