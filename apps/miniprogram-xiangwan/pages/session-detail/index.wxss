/* 活动详情页级样式：公共类在 app.wxss（原型 detail-body/action-bar） */

.detail-page {
  padding-top: 24rpx;
  background: #ffffff;
}

.detail-meta {
  margin-top: 30rpx;
  padding: 6rpx 22rpx;
  border: 1rpx solid #e6ebf1;
  border-radius: 16rpx;
  background: #ffffff;
}

.detail-section-title {
  margin: 42rpx 0 0;
  color: #10233f;
  font-size: 34rpx;
  font-weight: 800;
}

.meta-note {
  margin-top: 4rpx;
  color: #7c8796;
  font-size: 21rpx;
}

.detail-card-action {
  float: right;
  color: #7c8796;
  font-size: 22rpx;
  font-weight: 400;
}

.detail-content-flow,
.detail-section-block {
  margin-top: 28rpx;
}

.detail-content-flow .content-block + .content-block {
  margin-top: 32rpx;
}

.detail-content-flow .content-block-image {
  margin-top: 0;
}

.content-block-image-fallback {
  display: flex;
  min-height: 160rpx;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  background: #eef2f6;
  color: #8b98a8;
  font-size: 24rpx;
}

.leaders-card,
.previous-review-card {
  padding: 0;
  border: 0;
  background: transparent;
}

.leaders-card .leaders-scroll {
  margin-top: 22rpx;
}

.previous-review-card .review-grid {
  margin-top: 20rpx;
}

.detail-section {
  margin-top: 40rpx;
}

.favorite-feedback {
  margin-top: 20rpx;
  color: #315b88;
  font-size: 22rpx;
  line-height: 1.5;
  text-align: center;
}

.favorite-feedback-error {
  color: #913d50;
}

.action-bar-price-label {
  display: none;
}

button.action-bar-primary {
  width: auto;
  min-width: 0;
  margin: 0;
}

button.action-bar-primary::after {
  border: 0;
}

button.action-bar-primary[disabled] {
  background: #c7d0dc;
  color: #40516a;
}

@media (max-width: 360px) {
  .action-bar-primary {
    padding: 0 24rpx;
    font-size: 24rpx;
  }
}
