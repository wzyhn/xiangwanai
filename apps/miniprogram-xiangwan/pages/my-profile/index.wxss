/* 资料编辑页级样式：头像圆/表单行/按钮均复用 app.wxss 公共类 */

.my-profile-page {
  padding-top: 24rpx;
}

.profile-edit-heading {
  margin-bottom: 22rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #e6ebf1;
}

.profile-edit-heading .section-heading {
  margin-top: 0;
  margin-bottom: 8rpx;
}

.profile-edit-intro {
  color: #7c8796;
  font-size: 22rpx;
  line-height: 1.55;
}

.profile-edit-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 20rpx 0 8rpx;
}

/* chooseAvatar 原生 button 需压掉 UA 默认样式,尺寸对齐 .profile-avatar */
.profile-avatar-button {
  position: relative;
  display: grid;
  width: 108rpx;
  height: 108rpx;
  flex: none;
  place-items: center;
  padding: 0;
  margin: 0;
  border: 0;
  border-radius: 50%;
  background: transparent;
  line-height: normal;
}

.profile-avatar-button::after {
  border: 0;
}

.profile-avatar-image {
  display: block;
  overflow: hidden;
}

.profile-avatar-mask {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: rgba(16, 35, 63, 0.45);
  color: #ffffff;
}

.profile-edit-copy {
  display: grid;
  min-width: 0;
  flex: 1;
  gap: 6rpx;
}

.profile-edit-title {
  color: #10233f;
  font-size: 26rpx;
  font-weight: 700;
}

.profile-edit-note {
  color: #7c8796;
  font-size: 22rpx;
  line-height: 1.45;
}

.field-hint {
  margin-top: 12rpx;
  color: #8a96a8;
  font-size: 21rpx;
  line-height: 1.45;
}

.saved-message {
  margin-top: 18rpx;
  color: #228d5a;
  font-size: 23rpx;
  line-height: 1.45;
  text-align: center;
}

.profile-save-action {
  width: 100%;
  margin-top: 28rpx;
}

/* TDesign medium buttons are inline-flex by default; the profile action is a
   full-width form action and must keep its label centered in a fixed box. */
.profile-save-button {
  display: flex;
  width: 100% !important;
  min-width: 100%;
  height: 88rpx;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  margin-right: 0;
  margin-left: 0;
  line-height: 1;
}

.profile-save-action .t-button,
.profile-save-action button {
  width: 100% !important;
  min-width: 0;
  box-sizing: border-box;
}

.profile-extension {
  margin-top: 52rpx;
  padding-top: 28rpx;
  border-top: 1rpx solid #e6ebf1;
}
.profile-extension .field-label {
  margin-top: 24rpx;
}
.profile-extension-save {
  width: 100%;
  margin-top: 24rpx;
}
